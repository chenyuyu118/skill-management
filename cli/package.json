{
  "name": "@suxin/cli-management",
  "version": "0.1.3",
  "description": "SKILL 管理 CLI — 安装、发布、拉取、推送 AI 技能",
  "type": "module",
  "bin": {
    "skill": "./dist/index.js"
  },
  "files": [
    "dist/index.js"
  ],
  "scripts": {
    "build": "bun build src/index.ts --outfile dist/index.js --target node",
    "compile": "bun build src/index.ts --compile --minify --outfile dist/skill",
    "compile:linux-x64": "bun build src/index.ts --compile --minify --target=bun-linux-x64 --outfile dist/skill-linux-x64",
    "compile:linux-arm64": "bun build src/index.ts --compile --minify --target=bun-linux-arm64 --outfile dist/skill-linux-arm64",
    "compile:darwin-x64": "bun build src/index.ts --compile --minify --target=bun-darwin-x64 --outfile dist/skill-darwin-x64",
    "compile:darwin-arm64": "bun build src/index.ts --compile --minify --target=bun-darwin-arm64 --outfile dist/skill-darwin-arm64",
    "compile:windows-x64": "bun build src/index.ts --compile --minify --target=bun-windows-x64 --outfile dist/skill-windows-x64.exe",
    "compile:all": "bun run compile:linux-x64 && bun run compile:linux-arm64 && bun run compile:darwin-x64 && bun run compile:darwin-arm64 && bun run compile:windows-x64",
    "prepublishOnly": "bun run build"
  },
  "keywords": ["skill", "ai", "cli", "kiro", "claude"],
  "license": "MIT",
  "publishConfig": {
    "registry": "http://192.168.1.244:8081/repository/npm-hosted/"
  },
  "engines": {
    "node": ">=18"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "typescript": "5.8.3"
  }
}
